KAIST_PRED_DIR=D:/M3D/kaist_predictions
UPENN_GBM_DIR=
UCSF_PDGM_DIR=

# --- LLM endpoints ------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
